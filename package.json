{
  "name": "@ax-design/surface",
  "version": "0.2.0",
  "description": "Web component that implements Surface of Axiom Design System: one shape, one tilt and one frame scheduler for every visual layer.",
  "keywords": [
    "web-components",
    "shape",
    "tilt",
    "axiom-design"
  ],
  "homepage": "https://github.com/ax-design/surface#readme",
  "bugs": {
    "url": "https://github.com/ax-design/surface/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ax-design/surface.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-utils.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "bench": "bun bench/run.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test:browser": "bun test-browser/run.ts",
    "demo": "bun demo/serve.ts",
    "check": "tsc -p tsconfig.check.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@ax-design/shape": "^0.2.0",
    "@ax-design/typed-om": "^0.1.0"
  },
  "devDependencies": {
    "@ax-design/acrylic": "^0.2.0",
    "@ax-design/elevation": "^0.1.0",
    "@ax-design/reveal-highlight": "^0.6.2",
    "@types/bun": "latest",
    "playwright": "^1.64.0",
    "typescript": "^5.6.0"
  }
}
